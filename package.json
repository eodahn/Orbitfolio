{
  "name": "orbitfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server.mjs",
    "start": "npm run build && node server.mjs",
    "migrate": "node -e \"import('./server/db.js').then(({openDatabase}) => openDatabase())\"",
    "seed": "node -e \"Promise.all([import('./server/db.js'), import('./server/seed.js')]).then(([{openDatabase},{seedDevelopmentData}]) => seedDevelopmentData(openDatabase()))\"",
    "test": "node --test tests/*.test.js",
    "test:browser": "npm run build && node tests/browser.mjs",
    "test:world": "node tests/world-browser.mjs",
    "test:projects": "node tests/projects-browser.mjs"
  },
  "dependencies": {
    "three": "^0.160.1"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
