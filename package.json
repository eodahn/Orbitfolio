{
  "name": "orbitfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server.mjs",
    "prestart": "npm run build",
    "start": "node server.mjs",
    "preserver": "npm run build",
    "migrate": "node scripts/migrate.mjs",
    "seed": "node scripts/seed.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "npm run build && node tests/browser.mjs",
    "test:world": "node tests/world-browser.mjs",
    "test:projects": "node tests/projects-browser.mjs",
    "server:php": "php -S 127.0.0.1:3000 backend/router.php",
    "migrate:php": "php backend/migrate.php",
    "test:php": "php backend/tests/contracts.php",
    "check:config": "node scripts/check-config.mjs",
    "backup:db": "node scripts/backup-database.mjs",
    "test:login": "npm run build && node tests/login-browser.mjs",
    "import:sqlite": "node scripts/import-sqlite.mjs",
    "test:postgres": "node tests/postgres.mjs",
    "test:startup": "node tests/startup-postgres.mjs",
    "seed:demo": "node scripts/seed-showcase.mjs",
    "test:features": "node tests/features-browser.mjs",
    "test:mobile": "node tests/mobile-browser.mjs"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "three": "^0.160.1"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
