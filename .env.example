# Configure in the hosting dashboard; never put secrets in frontend variables.
APP_ORIGIN=http://localhost:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
# 64 hex characters (32 random bytes); keep stable and back it up securely.
GITHUB_TOKEN_ENCRYPTION_KEY=
# Required in production; set the provider URL privately in the hosting dashboard.
DATABASE_URL=
# Optional local development / SQLite backup source. Ignored by production API.
ORBITFOLIO_DATABASE_PATH=./data/orbitfolio.sqlite
ORBITFOLIO_REQUIRE_EXISTING_DATABASE=false
# Enable only AFTER importing existing data, or for a new empty installation.
SEED_SHOWCASE=false
SEED_DEMO=false

# Historical PHP/MySQL backend only; the root Dockerfile uses Node/PostgreSQL.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=orbitfolio
DB_USER=orbitfolio
DB_PASSWORD=
# Optional path to the database provider CA certificate for verified TLS.
DB_SSL_CA=
# Enable only when the database account has migration/ALTER privileges.
MIGRATE_ON_START=false
