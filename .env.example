# Configure in the hosting dashboard; never put secrets in frontend variables.
APP_ORIGIN=http://localhost:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 64 hex characters (32 random bytes); keep stable and back it up securely.
GITHUB_TOKEN_ENCRYPTION_KEY=
# Persistent disk path in production; do not use an ephemeral deployment filesystem.
ORBITFOLIO_DATABASE_PATH=./data/orbitfolio.sqlite
SEED_DEMO=false

# PHP/MySQL backend adapted from tcc/back1 (Docker deployment).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=orbitfolio
DB_USER=orbitfolio
DB_PASSWORD=
# Optional path to the database provider CA certificate for verified TLS.
DB_SSL_CA=
# Enable only when the database account has migration/ALTER privileges.
MIGRATE_ON_START=false
